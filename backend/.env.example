# Copy this file to .env and fill in real values.

DATABASE_URL=postgresql://tracker_app:CHANGE_ME@localhost:5432/personal_tracker

# Random long string used to sign auth JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173,http://localhost,capacitor://localhost

# Optional: enables the AI assistant (natural-language task creation, goal
# breakdown suggestions, insights). Get a key from https://aistudio.google.com/apikey
# — the app works fully without this set; the AI routes just return a
# "not configured" error until it is.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
